---
description: 
globs: backend/*
alwaysApply: false
---
name: Backend Rules
description: Rules for FastAPI backend code organization and style

directory_structure:
  backend:
    - app/
      - api/
      - core/
      - db/
      - models/
      - schemas/
      - services/
      - utils/
      - tests/

rules:
  - name: python_docstrings
    pattern: "**/*.py"
    requirements:
      - "All functions must have Google-style docstrings"
    example: |
      def process_data(input_data: dict) -> dict:
          """Process the input data and return transformed result.
          
          Args:
              input_data (dict): The input data to process
              
          Returns:
              dict: Processed data with transformed values
              
          Raises:
              ValueError: If input_data is invalid
          """

  - name: type_hints
    pattern: "**/*.py"
    requirements:
      - "All functions must use type hints"
      - "All class attributes must be typed"

  - name: api_structure
    pattern: "app/api/**/*.py"
    requirements:
      - "API routes should be organized by resource"
      - "Each endpoint should have proper input validation"
      - "Response models should be defined using Pydantic" 